{
  "name": "datchord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Datchord — a warm, expressive home for your communities.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "check:locales": "node scripts/check-locales.mjs",
    "reset": "node scripts/reset.mjs",
    "smoke": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.5"
  }
